# Twitter/X login (used by twikit to log in / refresh the session).
# This is the only credential scripts/fetch_tweets.py needs — there's no
# official X API key involved, twikit drives the real web client.
TWITTER_EMAIL=you@example.com
TWITTER_PASSWORD=your_password
TWITTER_USERNAME=your_handle_without_at

# Optional: a pre-serialized cookies.json to seed the session in CI (GitHub
# Actions / Railway) instead of logging in with a password every run.
# TWITTER_COOKIES_JSON={"...": "..."}

# Supabase (optional — only needed if you want the live web UI in server/ +
# web/. scripts/fetch_tweets.py saves tweets to data/<source>.json in this
# repo regardless of whether Supabase is configured; pass --no-supabase to
# skip Supabase entirely, or --no-local to skip the repo files.)
# Use the publishable / anon key, not the service role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxx
