# Twitter/X login — twikit uses these to open a browser-like session.
# No official Twitter API key needed.
TWITTER_EMAIL=you@example.com
TWITTER_PASSWORD=your_password
TWITTER_USERNAME=your_handle_without_at

# Optional: paste the JSON from data/.cookies.json here to skip re-login
# (useful for Railway / GitHub Actions deployments).
# TWITTER_COOKIES_JSON=

# Supabase (optional — tweets are saved locally in data/tweets/ by default).
# Only needed if you also want to push to a Supabase database.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxx
