# Twitter/X credentials — used by twikit (no official API key needed)
TWITTER_EMAIL=you@example.com
TWITTER_PASSWORD=your_password
TWITTER_USERNAME=your_handle_without_at

# Optional: paste the JSON content of your cookies file to skip login
# (useful for Railway / CI environments)
# TWITTER_COOKIES_JSON={"auth_token":"...","ct0":"..."}

# Supabase (only needed for server/main.py and scripts/fetch_tweets.py)
# Not required for scripts/save_local.py
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxx
