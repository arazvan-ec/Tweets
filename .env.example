# Twitter/X login — used by twikit (no official API needed, just your account)
TWITTER_EMAIL=you@example.com
TWITTER_PASSWORD=your_password
TWITTER_USERNAME=your_handle_without_at

# Alternative: paste the JSON cookies string exported from your browser session.
# If this is set, email/password/username are not needed.
# TWITTER_COOKIES_JSON={"auth_token":"...","ct0":"..."}

# Supabase (only needed for scripts/fetch_tweets.py — NOT for fetch_and_save.py)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxx
