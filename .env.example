# Twitter/X login (used by twikit — no official API key required)
TWITTER_EMAIL=you@example.com
TWITTER_PASSWORD=your_password
TWITTER_USERNAME=your_handle_without_at

# Supabase — only needed for scripts/fetch_tweets.py and the web server.
# Not required if you only use scripts/fetch_local.py (saves to data/tweets/).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxx
