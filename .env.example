# Twitter/X login (used by twikit to refresh the session)
TWITTER_EMAIL=you@example.com
TWITTER_PASSWORD=your_password
TWITTER_USERNAME=your_handle_without_at

# Optional: pre-saved session cookies (JSON, as written by twikit's
# save_cookies) so CI/GitHub Actions can skip a fresh login. Used as the
# TWITTER_COOKIES_JSON secret by .github/workflows/fetch-tweets.yml.
TWITTER_COOKIES_JSON=

# Supabase (optional — only needed for scripts/sync_to_supabase.py)
# Use the publishable / anon key, not the service role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxx
