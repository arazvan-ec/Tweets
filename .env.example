# Twitter/X login (used by twikit to refresh the session)
TWITTER_EMAIL=you@example.com
TWITTER_PASSWORD=your_password
TWITTER_USERNAME=your_handle_without_at

# Alternative to EMAIL/PASSWORD: paste the JSON produced by
# twikit's client.save_cookies() here to skip logging in from scratch.
# This is what the "Archive my tweets" GitHub Actions workflow uses
# (as the TWITTER_COOKIES_JSON repo secret) so it doesn't have to log in
# on every scheduled run.
# TWITTER_COOKIES_JSON={"ct0": "...", "auth_token": "..."}

# Supabase (optional — only needed for scripts/sync_to_supabase.py)
# Use the publishable / anon key, not the service role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxx
